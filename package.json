{
  "name": "grindemia-wf-tracker",
  "version": "1.0.0",
  "description": "Warframe Mastery and Farming Tracker for Grindemia YouTube community with Clean Architecture",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "server": "ts-node -O '{\"module\": \"commonjs\"}' src/infrastructure/server/index.ts",
    "start": "NODE_ENV=production node dist/server/src/infrastructure/server/index.js"
  },
  "keywords": [
    "warframe",
    "clean-architecture",
    "mastery",
    "farming",
    "typescript",
    "react",
    "vite"
  ],
  "author": "Grindemia Community",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum ProgressStatus {
  PENDING      // Pendiente
  LEVELING     // Subiendo de nivel
  MASTERED     // Masterizado (Rango 30 o 40)
}

enum ItemCategory {
  WARFRAME
  PRIMARY_WEAPON
  SECONDARY_WEAPON
  MELEE_WEAPON
  COMPANION
  VEHICLE // Archwing, Necramech, K-Drive
  OTHER
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  progress     UserProgress[]
  farmingList  FarmingItem[]

  @@map("users")
}

model Item {
  id            String        @id // ID único proveído por la API de Warframe (e.g., "/Lotus/Types/Warframes/Excalibur")
  name          String
  uniqueName    String        @unique
  category      ItemCategory
  masteryPoints Int           // 6000 para Warframes/Compañeros, 3000 para armas
  maxRank       Int           @default(30) // 30 por defecto, 40 para Kuva/Tenet/Paracesis
  wikiaUrl      String?
  imageUrl      String?
  components    Json?         // Detalle de componentes necesarios para fabricarlo (Blueprint components)
  
  progress      UserProgress[]
  farmingItems  FarmingItem[]

  @@map("items")
}

model UserProgress {
  id          String         @id @default(uuid())
  userId      String
  itemId      String
  status      ProgressStatus @default(PENDING)
  currentRank Int            @default(0)
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Un usuario solo puede tener un registro de progreso por cada ítem
  @@unique([userId, itemId])
  @@index([userId])
  @@map("user_progress")
}

model FarmingItem {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  notes     String?  // Notas personalizadas de farmeo (ej: "Falta plano de chasis")
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Evitamos duplicar un mismo ítem en la lista de farmeo activa
  @@unique([userId, itemId])
  @@index([userId])
  @@map("farming_items")
}
